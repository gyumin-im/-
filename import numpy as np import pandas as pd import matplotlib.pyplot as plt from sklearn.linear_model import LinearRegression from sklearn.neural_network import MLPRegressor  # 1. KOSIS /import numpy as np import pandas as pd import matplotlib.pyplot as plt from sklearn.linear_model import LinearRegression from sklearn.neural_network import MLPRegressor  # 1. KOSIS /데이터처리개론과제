import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.neural_network import MLPRegressor

# 1. KOSIS / 한국조선해양플랜트협회 공개 통계 기반 데이터 구성
# X: 선박 건조량 (만 CGT), Y: 조선업 매출액 (십억 원)
ship_data = {
    '건조량(만CGT)': [150, 200, 250, 310, 380, 420, 450, 500, 520, 580],
    '매출액(십억원)': [1200, 1500, 2100, 3200, 4500, 4800, 4900, 5100, 5150, 5300]
}

df = pd.DataFrame(ship_data)
X = df[['건조량(만CGT)']].values
Y = df['매출액(십억원)'].values

# 2. 선형회귀(Linear Regression) 모델 학습
linear_model = LinearRegression()
linear_model.fit(X, Y)

a = linear_model.coef_[0]
b = linear_model.intercept_

# 회귀선을 부드럽게 그리기 위한 연속 X 데이터 생성
X_seq = np.linspace(100, 620, 300).reshape(-1, 1)
Y_pred_linear = linear_model.predict(X_seq)

# 3. 비선형회귀(인공신경망 - Sigmoid 활성화 함수) 모델 학습
nn_model = MLPRegressor(
    hidden_layer_sizes=(15, 15), 
    activation='logistic', # Sigmoid 활성화 함수 사용
    solver='lbfgs', 
    max_iter=10000, 
    random_state=42
)
nn_model.fit(X, Y)
Y_pred_nn = nn_model.predict(X_seq)

# 4. 시각화 (plot)
plt.figure(figsize=(10, 6))

# 원본 데이터 점 찍기 (Scatter Plot)
plt.scatter(X, Y, color='navy', s=80, label='KOSIS Data (X: CGT, Y: Revenue)', zorder=5)

# 선형회귀 직선 그리기
plt.plot(X_seq, Y_pred_linear, color='red', linewidth=2, label=f'Linear Fit (y = {a:.2f}x + {b:.2f})')

# 비선형회귀 곡선 그리기
plt.plot(X_seq, Y_pred_nn, color='green', linewidth=2, linestyle='--', label='Non-linear Fit (ANN - Sigmoid)')

plt.title('Shipbuilding Volume vs Revenue Analysis', fontsize=14)
plt.xlabel('Shipbuilding Volume (10k CGT)', fontsize=12)
plt.ylabel('Revenue (Billion KRW)', fontsize=12)
plt.legend(fontsize=11)
plt.grid(True, linestyle=':', alpha=0.7)
plt.show()
